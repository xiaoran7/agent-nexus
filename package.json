{
  "name": "@xiaoran7/agent-nexus",
  "version": "0.3.4",
  "description": "Zero-overhead Multi-Agent Concurrency Coordinator & Cross-Machine Context Relay for Claude Code. Prevents file edit collisions, Git worktree conflicts, and cross-node race conditions.",
  "main": "src/daemon/index.js",
  "type": "module",
  "bin": {
    "nexus": "src/cli.js",
    "agent-nexus": "src/cli.js"
  },
  "files": [
    "src",
    "docs",
    "README.md",
    "README_EN.md",
    "llms.txt",
    "llms-full.txt",
    "CHANGELOG.md",
    "desktop"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoran7/agent-nexus.git"
  },
  "homepage": "https://github.com/xiaoran7/agent-nexus#readme",
  "bugs": {
    "url": "https://github.com/xiaoran7/agent-nexus/issues"
  },
  "scripts": {
    "start": "node src/cli.js start",
    "probe:install": "node src/cli.js probe:install",
    "probe:status": "node src/cli.js probe:status",
    "desktop": "electron desktop/main.cjs",
    "package:win": "node scripts/build-exe.cjs",
    "test": "node --test \"test/**/*.test.js\"",
    "ci": "npm ci && npm test"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^34.2.0"
  },
  "keywords": [
    "agent",
    "coordinator",
    "claude-code",
    "multi-agent",
    "concurrency-control",
    "conflict-detection",
    "git-worktree",
    "context-handoff",
    "engineering-memory",
    "developer-tools",
    "coding-assistant"
  ],
  "author": "tangwg",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.21.3"
  }
}
