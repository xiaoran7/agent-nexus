{
  "name": "agent-nexus",
  "version": "0.2.6",
  "description": "Zero-overhead Concurrency Coordinator & Resilient AI Gateway for Multi-Agent Coding (Claude Code, Codex, Cursor). Prevents file edit collisions and Git worktree conflicts.",
  "main": "src/daemon/index.js",
  "type": "module",
  "bin": {
    "nexus": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js start",
    "desktop": "electron desktop/main.cjs",
    "package:win": "node scripts/build-exe.cjs",
    "test": "node --test \"test/**/*.test.js\"",
    "ci": "npm ci && npm test"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^34.2.0"
  },
  "keywords": [
    "agent",
    "coordinator",
    "claude-code",
    "codex",
    "cursor",
    "multi-agent",
    "concurrency-control",
    "conflict-detection",
    "git-worktree",
    "ai-gateway",
    "circuit-breaker",
    "developer-tools",
    "coding-assistant"
  ],
  "author": "tangwg",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.21.3"
  }
}
